{
  "name": "lestingcraft-coop-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/node.js",
    "dev:cloudflare": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "test:fauna": "node test/fauna-integration.js",
    "test:integration": "node test/integration.js && node test/survival-integration.js",
    "test:expedition": "node test/expedition-integration.js",
    "test:living": "node test/living-integration.js"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22"
  }
}
