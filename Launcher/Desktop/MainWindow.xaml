<Window x:Class="LestingCraft.Launcher.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LestingCraft · Launcher" Width="1120" Height="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanMinimize" UseLayoutRounding="True"
        FontFamily="Segoe UI" Foreground="{StaticResource Text}">

  <Border Margin="12" CornerRadius="18" Background="#0E150F" BorderBrush="#2A3826" BorderThickness="1" ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- SIDEBAR -->
      <Border Background="#0A100B">
        <Grid Margin="20,22,20,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Margin="4,0,0,30">
            <Grid Width="42" Height="42">
              <Border CornerRadius="11" Background="{StaticResource GoldGradient}"/>
              <Viewbox Margin="8">
                <Canvas Width="24" Height="24">
                  <Path Data="M12,3.5 L19.5,7.5 L12,11.5 L4.5,7.5 Z" Fill="#FBE7B8"/>
                  <Path Data="M4.5,7.5 L12,11.5 V20.5 L4.5,16.5 Z" Fill="#5B3D17"/>
                  <Path Data="M12,11.5 L19.5,7.5 V16.5 L12,20.5 Z" Fill="#2B1C0A"/>
                </Canvas>
              </Viewbox>
            </Grid>
            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
              <TextBlock Text="LESTINGCRAFT" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="NEW ERA · LAUNCHER" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Row="1" Text="НАВИГАЦИЯ" Style="{StaticResource Caption}" Foreground="{StaticResource Dim}" Margin="8,0,0,8"/>

          <StackPanel Grid.Row="2">
            <RadioButton x:Name="NavHome" GroupName="Nav" Tag="0" Style="{StaticResource NavItem}" Checked="NavChecked">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Data="M3,11 L12,3.5 L21,11 M5.5,9.5 V20 H10 V14.5 H14 V20 H18.5 V9.5"/>
                <TextBlock Text="Главная" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavVersion" GroupName="Nav" Tag="1" Style="{StaticResource NavItem}" Checked="NavChecked">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Data="M12,2.5 L20,7 V17 L12,21.5 L4,17 V7 Z M4,7 L12,11.5 L20,7 M12,11.5 V21.5"/>
                <TextBlock Text="Установка" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavSettings" GroupName="Nav" Tag="2" Style="{StaticResource NavItem}" Checked="NavChecked">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Data="M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 Z M12,2.5 V5 M12,19 V21.5 M2.5,12 H5 M19,12 H21.5 M5.3,5.3 L7,7 M17,17 L18.7,18.7 M5.3,18.7 L7,17 M17,7 L18.7,5.3"/>
                <TextBlock Text="Настройки" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>

          <Border Grid.Row="3" Background="#121B13" CornerRadius="12" Padding="14,12" BorderBrush="#2A3826" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="СОСТОЯНИЕ" Style="{StaticResource Caption}" Foreground="{StaticResource Dim}"/>
              <TextBlock x:Name="SidebarState" Text="Проверка…" FontSize="13" Foreground="{StaticResource Text}" Margin="0,5,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="Лаунчер 0.2.0 · тестовый канал" FontSize="10" Foreground="{StaticResource Dim}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- MAIN COLUMN -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="46"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: drag area + window controls -->
        <Grid Background="Transparent" MouseLeftButtonDown="TitleDrag">
          <TextBlock x:Name="PageTitle" Text="Главная" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="26,0,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
            <Border CornerRadius="8" Padding="10,4" Margin="0,5,14,0" Background="#18241A" BorderBrush="#34452F" BorderThickness="1">
              <TextBlock Text="ТЕСТОВЫЙ КАНАЛ · WINDOWS x64" FontSize="10" Foreground="{StaticResource Muted}"/>
            </Border>
            <Button Style="{StaticResource WinButton}" Click="MinClick" ToolTip="Свернуть">
              <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.6" Data="M4,12 H20"/>
            </Button>
            <Button Style="{StaticResource WinClose}" Click="CloseClick" ToolTip="Закрыть">
              <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,5 L19,19 M19,5 L5,19"/>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="26,4,26,22">

          <!-- PAGE: HOME -->
          <Grid x:Name="PageHome">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="18" ClipToBounds="True" Background="{StaticResource HeroGradient}" BorderBrush="#2A3826" BorderThickness="1">
              <Grid>
                <!-- atmosphere -->
                <Canvas>
                  <Ellipse Width="420" Height="420" Canvas.Left="470" Canvas.Top="-90" Fill="{StaticResource GoldGlow}"/>
                  <Ellipse Canvas.Left="610" Canvas.Top="190" Width="200" Height="36" Fill="{StaticResource GroundShadow}"/>
                  <Ellipse Canvas.Left="40" Canvas.Top="34" Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.5"/>
                  <Ellipse Canvas.Left="180" Canvas.Top="88" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.35"/>
                  <Ellipse Canvas.Left="300" Canvas.Top="24" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.4"/>
                  <Ellipse Canvas.Left="420" Canvas.Top="130" Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.3"/>
                  <Ellipse Canvas.Left="250" Canvas.Top="170" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.25"/>
                  <Ellipse Canvas.Left="90" Canvas.Top="200" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.3"/>
                  <Ellipse Canvas.Left="520" Canvas.Top="40" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.45"/>
                  <Ellipse Canvas.Left="690" Canvas.Top="70" Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.4"/>
                </Canvas>

                <!-- voxel landscape -->
                <Viewbox HorizontalAlignment="Right" VerticalAlignment="Top" Width="340" Margin="0,54,44,0">
                  <Canvas Width="290" Height="160">
                    <Path Data="M20,100 L142,38 266,100 143,159Z" Fill="#455B34"/>
                    <Path Data="M20,100 L20,124 143,184 143,159Z" Fill="#263A23"/>
                    <Path Data="M143,159 L266,100 266,124 143,184Z" Fill="#34482A"/>
                    <Path Data="M86,93 L142,66 194,93 142,120Z" Fill="#C1A06C"/>
                    <Path Data="M86,93 L86,130 142,159 142,120Z" Fill="#7C6445"/>
                    <Path Data="M142,120 L194,93 194,130 142,159Z" Fill="#A38255"/>
                    <Path Data="M78,87 L141,43 204,87 141,118Z" Fill="#65794A"/>
                    <Path Data="M141,43 L141,80 204,109 204,87Z" Fill="#3D5635"/>
                    <Path Data="M221,78 L221,110 233,116 233,81Z" Fill="#66543A"/>
                    <Path Data="M202,44 L225,31 250,44 226,58Z M202,44 L202,75 226,88 226,58Z" Fill="#64824C"/>
                    <Path Data="M226,58 L250,44 250,75 226,88Z" Fill="#405D38"/>
                  </Canvas>
                </Viewbox>

                <!-- title + actions -->
                <Grid Margin="36,30,36,28">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <StackPanel>
                    <Border Background="#2B2413" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left">
                      <TextBlock Text="РАННИЙ ДОСТУП · ТЕСТОВАЯ СБОРКА" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/>
                    </Border>
                    <TextBlock Text="LESTINGCRAFT" FontSize="44" FontWeight="Bold" Margin="0,16,0,0"/>
                    <TextBlock Text="NEW  ERA" FontSize="18" FontWeight="Light" Foreground="{StaticResource Gold}" Margin="3,-4,0,0"/>
                    <TextBlock Text="Крафт. Убежище. Сервер друзей." FontSize="15" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
                    <TextBlock x:Name="ChipText" Text="Сборка не установлена" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0"/>
                  </StackPanel>

                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Play" Style="{StaticResource Primary}" Content="ИГРАТЬ" Click="PlayClick"
                            IsEnabled="False" Width="232" Height="64"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock x:Name="Status" Text="Проверка канала обновлений…" FontSize="13" Foreground="{StaticResource Gold}"
                                 TextWrapping="Wrap" MinHeight="38" LineHeight="19"/>
                      <Grid Margin="0,8,0,0" ClipToBounds="True">
                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"/>
                        <Border x:Name="ShimmerLayer" Width="160" HorizontalAlignment="Left" Height="6" CornerRadius="3"
                                Background="{StaticResource ShimmerBrush}" Visibility="Collapsed">
                          <Border.RenderTransform>
                            <TranslateTransform x:Name="ShimmerTransform"/>
                          </Border.RenderTransform>
                        </Border>
                      </Grid>
                      <TextBlock x:Name="PercentText" Text="" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="Update" Content="Обновить" Click="UpdateClick" IsEnabled="False" Margin="0,0,10,0"/>
                      <Button x:Name="Check" Content="Проверить" Click="CheckClick"/>
                      <Button x:Name="Cancel" Content="Отмена" Click="CancelClick" IsEnabled="False" Margin="10,0,0,0"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                  <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource Gold}" HorizontalAlignment="Left"
                        Data="M12,2.5 L13.9,10.1 L21.5,12 L13.9,13.9 L12,21.5 L10.1,13.9 L2.5,12 L10.1,10.1 Z"/>
                  <TextBlock Text="Графика v3" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                  <TextBlock Style="{StaticResource Body}" FontSize="12" Text="Новое освещение, PBR-материалы и настройки качества визуала."/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                  <Path Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource Gold}" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left"
                        Data="M3,6.5 H21 V17.5 H3 Z M7.5,6.5 V17.5 M16.5,6.5 V17.5"/>
                  <TextBlock Text="Катсцены сюжета" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                  <TextBlock Style="{StaticResource Body}" FontSize="12" Text="Камера ведёт сцены по плавным траекториям, а удары сопровождаются толчками."/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                  <Path Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource Gold}" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Left"
                        Data="M12,3 L20,6 V12 C20,16.5 16.5,20 12,21 C7.5,20 4,16.5 4,12 V6 Z M8.8,12 L11,14.2 L15.4,9.8"/>
                  <TextBlock Text="Безопасные обновления" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                  <TextBlock Style="{StaticResource Body}" FontSize="12" Text="Файлы проверяются SHA-256. Прежняя версия остаётся, пока новая не готова."/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- PAGE: INSTALL -->
          <Grid x:Name="PageVersion" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="УСТАНОВЛЕННАЯ СБОРКА" Style="{StaticResource Caption}"/>
                  <Border x:Name="StateBorder" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left" Margin="0,12,0,0" Background="#1E2A1D">
                    <TextBlock x:Name="StateTag" Text="НЕ УСТАНОВЛЕНА" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  </Border>
                  <TextBlock x:Name="VersionLabel" Text="Игра не установлена" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,0"/>
                  <TextBlock x:Name="BuildDetail" Text="—" Style="{StaticResource Mono}" Margin="0,10,0,0"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,18,0,0"
                             Text="Установленная версия запускается без интернета. Сохранения находятся отдельно и лаунчером не затрагиваются."/>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="ДЕЙСТВИЯ" Style="{StaticResource Caption}"/>
                  <Button x:Name="Import" Content="Уже есть игра на диске?" Click="ImportClick" IsEnabled="False" Margin="0,16,0,0" HorizontalContentAlignment="Left"/>
                  <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="2,6,0,0"
                             Text="Выберите папку с LestingCraft.exe: совпадающие файлы не будут скачаны повторно."/>
                  <Button x:Name="RollbackButton" Content="Откатить на предыдущую версию" Click="RollbackClick" IsEnabled="False" Margin="0,16,0,0" HorizontalContentAlignment="Left"/>
                  <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="2,6,0,0"
                             Text="Доступно, когда есть сохранённая предыдущая версия и игра закрыта."/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="ПАПКА ЛАУНЧЕРА" Style="{StaticResource Caption}"/>
                  <TextBlock x:Name="RootPath" Style="{StaticResource Mono}" Margin="0,12,0,0" Foreground="{StaticResource Text}"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,14,0,0"
                             Text="Версии хранятся отдельными папками. Незавершённая загрузка не переключает текущую версию. Каждый файл проверяется SHA-256."/>
                </StackPanel>
                <Button Grid.Column="1" Content="Открыть папку" Click="OpenFolderClick" VerticalAlignment="Top"/>
              </Grid>
            </Border>
          </Grid>

          <!-- PAGE: SETTINGS -->
          <Grid x:Name="PageSettings" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="КОД ТЕСТОВОГО ДОСТУПА" Style="{StaticResource Caption}"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,12,0,16" FontSize="12"
                             Text="Это код приглашения в тестовый канал. Не GitHub-токен и не пароль. Хранится в Windows (DPAPI) только для вашей учётной записи."/>
                  <PasswordBox x:Name="Invite" ToolTip="Код приглашения"/>
                  <Button x:Name="SaveKey" Content="Сохранить и проверить" Click="CheckClick" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="О ЛАУНЧЕРЕ" Style="{StaticResource Caption}"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0" FontSize="12"
                             Text="Версия 0.2.0 · Windows x64 · WPF / .NET 8. Без рекламных SDK, телеметрии и GitHub/Cloudflare-токенов. Сам лаунчер обновляется вручную."/>
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                  <TextBlock Text="ЖУРНАЛ СОБЫТИЙ" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                  <Button Content="Скопировать" Click="CopyLogClick" HorizontalAlignment="Right" Padding="12,6" FontSize="12"/>
                </Grid>
                <ListBox Grid.Row="1" x:Name="LogList" Margin="0,14,0,0"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
