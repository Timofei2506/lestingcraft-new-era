<Window x:Class="LestingCraft.Launcher.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LestingCraft · Launcher" Width="1000" Height="690" MinWidth="850" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#101710" Foreground="#ECEBDD" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#EFBA69"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#253022"/><Setter Property="Foreground" Value="#ECEBDD"/><Setter Property="Padding" Value="16,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="34,27,34,24"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="✦" FontSize="31" Foreground="{StaticResource Gold}" Margin="0,0,15,0"/><StackPanel><TextBlock Text="LESTINGCRAFT" FontSize="18" FontWeight="Bold"/><TextBlock Text="N E W   E R A    /    L A U N C H E R" FontSize="9" Foreground="#A5B29C" Margin="1,5,0,0"/></StackPanel></StackPanel><TextBlock Text="WINDOWS x64  ·  ТЕСТОВЫЙ КАНАЛ" FontSize="10" Foreground="#A5B29C" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1" Margin="0,22,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border CornerRadius="10" BorderBrush="#34432E" BorderThickness="1" Padding="29"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#263722"/><GradientStop Color="#121D13" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ТВОЯ ЭКСПЕДИЦИЯ ПРОДОЛЖАЕТСЯ" FontSize="10" Foreground="{StaticResource Gold}"/><TextBlock Grid.Row="1" Text="Снова домой.&#10;Дальше — вместе." FontSize="35" FontWeight="Bold" Margin="0,22,0,14" LineHeight="44"/><Viewbox Grid.Row="2" MaxHeight="165" HorizontalAlignment="Left"><Canvas Width="290" Height="160"><Path Data="M20,100 L142,38 266,100 143,159Z" Fill="#455B34"/><Path Data="M20,100 L20,124 143,184 143,159Z" Fill="#263A23"/><Path Data="M143,159 L266,100 266,124 143,184Z" Fill="#34482A"/><Path Data="M86,93 L142,66 194,93 142,120Z" Fill="#C1A06C"/><Path Data="M86,93 L86,130 142,159 142,120Z" Fill="#7C6445"/><Path Data="M142,120 L194,93 194,130 142,159Z" Fill="#A38255"/><Path Data="M78,87 L141,43 204,87 141,118Z" Fill="#65794A"/><Path Data="M141,43 L141,80 204,109 204,87Z" Fill="#3D5635"/><Path Data="M221,78 L221,110 233,116 233,81Z" Fill="#66543A"/><Path Data="M202,44 L225,31 250,44 226,58Z M202,44 L202,75 226,88 226,58Z" Fill="#64824C"/><Path Data="M226,58 L250,44 250,75 226,88Z" Fill="#405D38"/></Canvas></Viewbox><TextBlock Grid.Row="3" Text="Крафт. Убежище. Сервер друзей.&#10;Ранний прототип — не законченная игра." Foreground="#AFBFA4" FontSize="12" Margin="0,18,0,0" LineHeight="22"/></Grid></Border>
   <StackPanel Grid.Column="2" Margin="0,5,0,0"><TextBlock Text="ЭКСПЕДИЦИЯ / 08" FontSize="11" Foreground="{StaticResource Gold}"/><TextBlock Text="Готов к путешествию?" FontSize="25" FontWeight="SemiBold" Margin="0,15,0,10"/><TextBlock Text="Лаунчер проверит файлы и скачает только то, что изменилось. Сохранения игры не затрагиваются." FontSize="13" Foreground="#A8B69E" LineHeight="21"/><Border Height="1" Background="#35422E" Margin="0,21"/><TextBlock Text="Код тестового доступа" FontSize="12" Margin="0,0,0,8"/><PasswordBox x:Name="Invite" Background="#182016" Foreground="#ECEBDD" BorderBrush="#46533B" Padding="11" FontSize="14" ToolTip="Не GitHub-токен и не пароль. Только код приглашения."/><TextBlock x:Name="VersionLabel" Text="Установленная версия: пока нет" Foreground="#ACBBA1" FontSize="12" Margin="0,18,0,10"/><TextBlock x:Name="Status" Text="Проверка канала обновлений…" FontSize="13" Foreground="{StaticResource Gold}" MinHeight="65" LineHeight="21"/><ProgressBar x:Name="Progress" Height="5" Background="#2B3827" Foreground="{StaticResource Gold}" Minimum="0" Maximum="100" Margin="0,8,0,16"/><Button x:Name="Play" Content="Играть  →" Background="{StaticResource Gold}" Foreground="#172013" FontSize="17" FontWeight="SemiBold" Click="PlayClick" IsEnabled="False" Padding="16,15"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Update" Content="Обновить" Click="UpdateClick" IsEnabled="False"/><Button Grid.Column="2" x:Name="Check" Content="Проверить" Click="CheckClick"/></Grid></StackPanel>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="Import" Content="Уже есть игра?" Click="ImportClick" Padding="12,8" FontSize="11"/><Button Content="Откат версии" Click="RollbackClick" Padding="12,8" FontSize="11" Margin="9,0,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="SHA-256 · отдельные версии · без установки .NET" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#8B9D80"/><Button Grid.Column="2" x:Name="Cancel" Content="Отменить" Click="CancelClick" Padding="12,8" FontSize="11" IsEnabled="False"/></Grid>
 </Grid>
</Window>
